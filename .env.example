# Ornek ortam degiskenleri.
# Bu dosyayi kopyalayip .env yapin ve degerleri doldurun.
# .env dosyasi GitHub'a commitlenmez.

# docker-compose.yml ile ayni kullanici / sifre / db adi olmali
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/mini_agent

# JWT icin gizli anahtar (uretimde guclu ve benzersiz olmali)
SECRET_KEY=change-me-in-local-env

# Access token suresi (dakika)
ACCESS_TOKEN_EXPIRE_MINUTES=30
