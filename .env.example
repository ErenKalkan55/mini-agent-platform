# Ornek ortam degiskenleri.
# Bu dosyayi kopyalayip .env yapin ve degerleri doldurun.
# .env dosyasi GitHub'a commitlenmez.

# docker-compose.yml ile ayni kullanici / sifre / db adi olmali
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/mini_agent

# JWT icin gizli anahtar (uretimde guclu ve benzersiz olmali)
SECRET_KEY=change-me-in-local-env

# Access token suresi (dakika)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# OpenRouter (Faz 2 LLM). Gercek key sadece .env icinde kalir.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEFAULT_MODEL=anthropic/claude-haiku-4.5

# Redis cache (opsiyonel). Bos birakilirsa uygulama sadece Postgres kullanir.
REDIS_URL=redis://localhost:6379/0

# Frontend origin listesi (CORS), virgulle ayirin.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
